{
  "info": {
    "name": "Serverless Auctions API",
    "description": "Flux end-to-end pentru stack-ul în trei părți. Setează baseUrl la noul API Gateway sau CloudFront; URL-uri vechi nu sunt reutilizate automat.\n\nListele returnează { items, nextCursor? }, cu limit=50 implicit și maximum 100. Pentru pagina următoare trimite cursorul primit neschimbat.\n\nCreate folosește Body > form-data: title, status=ACTIVE, endDate și image JPEG/PNG/WebP, maximum 5 MiB. Selectează un fișier real și nu seta manual Content-Type. Răspunsul conține WebP prin imageUrl valabil 300 secunde. După auto-close, imageUrl lipsește și derivatele private sunt șterse.\n\nMutațiile cer Cognito JWT. Creează un utilizator numai cu ./scripts/create-cognito-test-user.sh <email> <password>, cu credențiale unice de test, apoi setează accessToken la IdToken. Creatorul și bidderul trebuie să fie utilizatori diferiți; identitatea vine din sub/email-ul JWT. GET rămâne public. Așteaptă endDate plus următorul tick EventBridge înainte de Verify auto-close.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://REPLACE_WITH_NEW_DEPLOYMENT_URL"
    },
    {
      "key": "auctionId",
      "value": ""
    },
    {
      "key": "endDate",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "updatedTitle",
      "value": "Postman test auction updated"
    },
    {
      "key": "nextCursor",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health readiness",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('DynamoDB and SQS are ready', function () {",
              "  pm.response.to.have.status(200);",
              "  const report = pm.response.json();",
              "  pm.expect(report.status).to.eql('ok');",
              "  pm.expect(report.checks.dynamodb).to.eql('up');",
              "  pm.expect(report.checks.sqs).to.eql('up');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get all auctions",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/auctions"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns a bounded auction page', function () {",
              "  pm.response.to.have.status(200);",
              "  const page = pm.response.json();",
              "  pm.expect(page.items).to.be.an('array');",
              "  pm.expect(page.items.length).to.be.at.most(50);",
              "  pm.collectionVariables.set('nextCursor', page.nextCursor || '');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get next auction page (requires nextCursor)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/auctions?cursor={{nextCursor}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Continuation cursor was returned by the previous page', function () {",
              "  pm.expect(pm.collectionVariables.get('nextCursor')).not.to.be.empty;",
              "});",
              "pm.test('Returns the next bounded page', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().items).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create auction with image (ends in 5 minutes)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const endDate = new Date(Date.now() + 5 * 60 * 1000).toISOString();",
              "pm.collectionVariables.set('endDate', endDate);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Auction was created with a temporary image URL', function () {",
              "  pm.response.to.have.status(201);",
              "  const auction = pm.response.json();",
              "  pm.expect(auction.id).to.be.a('string');",
              "  pm.expect(auction.status).to.eql('ACTIVE');",
              "  pm.expect(auction.endDate).to.eql(pm.collectionVariables.get('endDate'));",
              "  pm.expect(auction.imageUrl).to.be.a('string');",
              "  pm.expect(auction).not.to.have.property('imageKey');",
              "  pm.collectionVariables.set('auctionId', auction.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "title",
              "value": "Postman test auction",
              "type": "text"
            },
            {
              "key": "status",
              "value": "ACTIVE",
              "type": "text"
            },
            {
              "key": "endDate",
              "value": "{{endDate}}",
              "type": "text"
            },
            {
              "key": "image",
              "type": "file",
              "src": []
            }
          ]
        },
        "url": "{{baseUrl}}/auctions"
      }
    },
    {
      "name": "Get auction by ID",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/auctions/{{auctionId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns the active auction with a temporary image URL', function () {",
              "  pm.response.to.have.status(200);",
              "  const auction = pm.response.json();",
              "  pm.expect(auction.id).to.eql(pm.collectionVariables.get('auctionId'));",
              "  pm.expect(auction.endDate).to.be.a('string');",
              "  pm.expect(auction.imageUrl).to.include('https://');",
              "  pm.expect(auction).not.to.have.property('imageKey');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Update auction title",
      "request": {
        "method": "PATCH",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"{{updatedTitle}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/auctions/{{auctionId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Auction was updated', function () {",
              "  pm.response.to.have.status(200);",
              "  const auction = pm.response.json();",
              "  pm.expect(auction.title).to.eql(pm.collectionVariables.get('updatedTitle'));",
              "  pm.expect(auction.endDate).to.be.a('string');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Place bid",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 25\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/auctions/{{auctionId}}/bids"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Bid was accepted', function () {",
              "  pm.response.to.have.status(201);",
              "  const auction = pm.response.json();",
              "  pm.expect(auction.currentBid).to.eql(25);",
              "  pm.expect(auction.highestBidderId).to.be.a('string');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get active auctions",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/auctions/active"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Active list contains the test auction with endDate', function () {",
              "  pm.response.to.have.status(200);",
              "  const { items: auctions } = pm.response.json();",
              "  const auction = auctions.find((item) => item.id === pm.collectionVariables.get('auctionId'));",
              "  pm.expect(auction).to.exist;",
              "  pm.expect(auction.endDate).to.be.a('string');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Verify auction appears in all auctions",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/auctions"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('All-auctions list includes endDate', function () {",
              "  pm.response.to.have.status(200);",
              "  const { items: auctions } = pm.response.json();",
              "  const auction = auctions.find((item) => item.id === pm.collectionVariables.get('auctionId'));",
              "  pm.expect(auction).to.exist;",
              "  pm.expect(auction.endDate).to.be.a('string');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Verify auto-close (run after deadline + up to 5 minutes)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/auctions/{{auctionId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expired auction was closed and its image URL was removed', function () {",
              "  pm.response.to.have.status(200);",
              "  const auction = pm.response.json();",
              "  pm.expect(auction.status).to.eql('CLOSED');",
              "  pm.expect(auction).not.to.have.property('imageUrl');",
              "  pm.expect(auction).not.to.have.property('imageKey');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}