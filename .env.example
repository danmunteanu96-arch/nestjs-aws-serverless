# Local development only. Lambda receives resource identifiers through api.yml/SSM.
NODE_ENV=development
APP_FUNCTION=local
PORT=3000
AWS_REGION=eu-central-1
AUCTIONS_TABLE=nestjs-aws-serverless-auctions-dev
AUCTION_IMAGES_BUCKET=nestjs-aws-serverless-auction-images-dev
CORS_ORIGINS=http://localhost:3000
API_DOCS_ENABLED=true

# Local placeholders only; deployed functions read the real values as SecureStrings.
SES_SENDER_EMAIL=you@example.com

# Required only for local worker/health tests against real dev resources.
WINNER_NOTIFICATIONS_QUEUE_URL=
WINNER_NOTIFICATIONS_DLQ_URL=
NOTIFICATION_IDEMPOTENCY_TABLE=

# Optional bounded local timeouts.
HEALTH_CHECK_TIMEOUT_MS=1000
SES_TIMEOUT_MS=5000
SES_RETRY_MAX_ATTEMPTS=3
SES_RETRY_BASE_MS=100
SES_CIRCUIT_FAILURE_THRESHOLD=3
SES_CIRCUIT_COOLDOWN_MS=30000

# Cost-safe deployment switches. These are safe defaults for the course
# profile; enable a paid feature only when you understand its billable impact.
# PITR is a billable backup feature; the infra stack defaults to off.
DYNAMODB_PITR_ENABLED=false
# A customer-managed KMS key has a monthly charge.
LAMBDA_CMK_ENABLED=false
# Reserved concurrency is optional and needs spare account quota.
LAMBDA_RESERVED_CONCURRENCY_ENABLED=false
# WAF has WebACL/rule/request charges.
WAF_ENABLED=false
# A custom domain needs ACM and Route 53 resources.
PROD_CUSTOM_DOMAIN_ENABLED=false
# Budget alert only; it does not stop spending.
BUDGET_LIMIT_USD=5