NODE_ENV=development
PORT=3000
AWS_REGION=eu-central-1
AUCTIONS_TABLE=nestjs-aws-serverless-auctions-dev
CORS_ORIGINS=http://localhost:3000
API_DOCS_ENABLED=true
SES_SENDER_EMAIL=you@example.com
